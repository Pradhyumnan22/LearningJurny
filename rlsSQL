-- ENABLE RLS

alter table public.profiles enable row level security;
alter table public.books enable row level security;
alter table public.loans enable row level security;


-- LIBRARIAN CHECK

create or replace function public.is_librarian()
returns boolean
language sql
security definer
stable
set search_path = ''
as $$
    select exists (
        select 1
        from public.profiles
        where id = auth.uid()
          and role = 'librarian'
    );
$$;


revoke execute on function public.is_librarian()
from public;

grant execute on function public.is_librarian()
to authenticated;


-- PROFILES

create policy "Users can view their own profile"
on public.profiles
for select
to authenticated
using (
    id = auth.uid()
);


create policy "Librarians can view all profiles"
on public.profiles
for select
to authenticated
using (
    public.is_librarian()
);


-- BOOKS

create policy "Authenticated users can view books"
on public.books
for select
to authenticated
using (true);


create policy "Librarians can create books"
on public.books
for insert
to authenticated
with check (
    public.is_librarian()
);


create policy "Librarians can update books"
on public.books
for update
to authenticated
using (
    public.is_librarian()
)
with check (
    public.is_librarian()
);


create policy "Librarians can delete books"
on public.books
for delete
to authenticated
using (
    public.is_librarian()
);


-- LOANS

create policy "Members can view their own loans"
on public.loans
for select
to authenticated
using (
    member_id = auth.uid()
);


create policy "Librarians can view all loans"
on public.loans
for select
to authenticated
using (
    public.is_librarian()
);


create policy "Librarians can create loans"
on public.loans
for insert
to authenticated
with check (
    public.is_librarian()
);


create policy "Librarians can update loans"
on public.loans
for update
to authenticated
using (
    public.is_librarian()
)
with check (
    public.is_librarian()
);


create policy "Librarians can delete loans"
on public.loans
for delete
to authenticated
using (
    public.is_librarian()
);